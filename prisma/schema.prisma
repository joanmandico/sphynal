generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  address   String?
  email     String?
  nif       String?
  phone     String?
  patients  Patient[]
  users     User[]
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  name             String
  role             Role           @default(PHYSIO)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  clinicId         String
  collegiateNumber String?
  specialty        String?
  notes            ClinicalNote[]
  consents         Consent[]
  episodes         Episode[]
  evaluations      Evaluation[]
  patients         Patient[]
  clinic           Clinic         @relation(fields: [clinicId], references: [id])
}

model Patient {
  id          String         @id @default(cuid())
  firstName   String
  lastName    String
  birthDate   DateTime
  occupation  String?
  sport       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  clinicId    String
  userId      String
  address     String?
  dni         String?
  email       String?
  phone       String?
  notes       ClinicalNote[]
  consents    Consent[]
  episodes    Episode[]
  evaluations Evaluation[]
  clinic      Clinic         @relation(fields: [clinicId], references: [id])
  user        User           @relation(fields: [userId], references: [id])
}

model Evaluation {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  bodyArea  String
  data      Json
  diagnosis String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patientId String
  userId    String
  episodeId String?
  episode   Episode? @relation(fields: [episodeId], references: [id])
  patient   Patient  @relation(fields: [patientId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  clinicalHistory ClinicalHistory?
}

model ClinicalNote {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patientId String
  userId    String
  patient   Patient  @relation(fields: [patientId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Episode {
  id          String        @id @default(cuid())
  name        String
  status      EpisodeStatus @default(OPEN)
  regions     String[]
  openedAt    DateTime      @default(now())
  closedAt    DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  patientId   String
  userId      String
  patient     Patient       @relation(fields: [patientId], references: [id])
  user        User          @relation(fields: [userId], references: [id])
  evaluations Evaluation[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Consent {
  id        String   @id @default(cuid())
  signedAt  DateTime @default(now())
  signature String
  createdAt DateTime @default(now())
  patientId String
  userId    String
  patient   Patient  @relation(fields: [patientId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model ClinicalHistory {
  id String @id @default(cuid())

  // Datos generales
  laborActivity         String?
  sportsActivity        String?
  hasPreviousDiagnosis  Boolean?
  previousDiagnosisWhat String?
  previousDiagnosisBy   String?

  // Motivo de consulta
  consultReason String

  // Características del dolor
  painCharacterType       PainCharacterType?
  radiatesPain            Boolean?
  radiatesTo              String?
  neurologicalSigns       Boolean?
  neurologicalSignsDetail String?
  jointClicking           Boolean?
  lockingSensation        Boolean?
  apprehension            Boolean?
  painTiming              PainTiming?
  painEVA                 Int?
  aggravatingFactors      String?
  relievingFactors        String?
  onsetDescription        String?
  onsetMechanism          String?
  evolution               EvolutionType?
  evolutionDetail         String?

  // Antecedentes
  previousTreatments     String?
  relevantMedicalHistory String?
  hasMedication          Boolean?
  medicationDetail       String?
  hasAllergies           Boolean?
  allergyDetail          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluationId String     @unique
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id])
}

enum PainCharacterType {
  PUNTUAL
  GENERAL
}

enum PainTiming {
  DIA
  NOCHE
  AMBOS
}

enum EvolutionType {
  MEJORANDO
  EMPEORANDO
  IGUAL
  ALTIBAJOS
}

enum Role {
  ADMIN
  PHYSIO
}

enum EpisodeStatus {
  OPEN
  CLOSED
}