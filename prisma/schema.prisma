generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinic {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  nif       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  patients  Patient[]
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String
  role              Role     @default(PHYSIO)
  collegiateNumber  String?
  specialty         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  clinicId          String
  clinic            Clinic   @relation(fields: [clinicId], references: [id])

  patients          Patient[]
  evaluations       Evaluation[]
  notes             ClinicalNote[]
  episodes          Episode[]
}

enum Role {
  ADMIN
  PHYSIO
}

model Patient {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  birthDate   DateTime
  occupation  String?
  sport       String?
  phone       String?
  dni         String?
  address     String?
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id])

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  evaluations Evaluation[]
  notes       ClinicalNote[]
  episodes    Episode[]
}

model Evaluation {
  id          String   @id @default(cuid())
  date        DateTime @default(now())
  bodyArea    String
  data        Json
  diagnosis   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  episodeId   String?

  episode     Episode? @relation(fields: [episodeId], references: [id])

  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id])

  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model ClinicalNote {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])

  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Episode {
  id          String        @id @default(cuid())
  name        String
  status      EpisodeStatus @default(OPEN)
  regions     String[]
  openedAt    DateTime      @default(now())
  closedAt    DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id])

  userId      String
  user        User          @relation(fields: [userId], references: [id])

  evaluations Evaluation[]
}

enum EpisodeStatus {
  OPEN
  CLOSED
}